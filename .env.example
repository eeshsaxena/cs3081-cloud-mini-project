# Copy to .env and edit. .env is gitignored so these never reach the repository.
# These are LOCAL DEVELOPMENT credentials for SeaweedFS only — not real cloud keys.

# S3 / SeaweedFS access (used by the workers, clean.py, and the service)
AWS_ACCESS_KEY_ID=cloudmini
AWS_SECRET_ACCESS_KEY=change-me-local-dev-secret
AWS_REGION=us-east-1

# S3 endpoint as seen from the cluster (service DNS). For local runs with a port-forward,
# use http://localhost:8333 instead.
S3_ENDPOINT=http://seaweedfs.data.svc.cluster.local:8333

# Teacher (Ollama)
OLLAMA_HOST=http://localhost:11434
TEACHER_MODEL=phi3.5
